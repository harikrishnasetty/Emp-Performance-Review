{
  "name": "meridian-performance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Meridian — in-house performance intelligence platform for MetricStream",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
