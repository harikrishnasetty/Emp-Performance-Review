# ─────────────────────────────────────────────────────────────────────────────
# Meridian — environment configuration
# Copy to `.env.local` for development, or `.env` for Docker Compose.
# NEVER commit a populated .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Public URL the browser uses. Must match the SSO redirect URI exactly.
APP_URL=http://localhost:3000
# Short product name used in email/UI copy.
APP_NAME=Meridian

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Direct connection used by migrations and scripts.
DATABASE_URL=postgresql://meridian:change-me-in-production@localhost:5432/meridian
# Runtime pool. In production, point this at PgBouncer (transaction pooling,
# port 6432 in docker-compose.yml). In local dev there's no PgBouncer
# (docker-compose.dev.yml only runs Postgres + Redis) — point this at the
# same Postgres instance as DATABASE_URL, or omit it entirely to fall back
# to DATABASE_URL (see src/lib/db/index.ts).
DATABASE_POOL_URL=postgresql://meridian:change-me-in-production@localhost:5432/meridian
DATABASE_POOL_MAX=20
DATABASE_SSL=false
# When true, session reads/writes are wrapped with `SET LOCAL app.actor_id`
# so PostgreSQL Row-Level Security policies are enforced (defence in depth).
RLS_ENFORCE=false

# ── Redis (rate limiting + cache) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# If Redis is unreachable the app falls back to an in-process limiter.
REDIS_REQUIRED=false

# ── Azure Entra ID (OIDC) ────────────────────────────────────────────────────
# App registration: "Meridian Performance"
# Redirect URI to register:  ${APP_URL}/api/auth/callback/entra
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-client-secret
# Comma-separated list of allowed email domains (defence against guest accounts).
ALLOWED_EMAIL_DOMAINS=metricstream.com
# Restrict to a single tenant. Keep true for in-house deployments.
ENTRA_STRICT_TENANT=true

# ── Security ─────────────────────────────────────────────────────────────────
# 32 random bytes, base64: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
# Used for AES-256-GCM field encryption. Rotating requires re-encryption.
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Signs CSRF double-submit tokens and signed export URLs.
APP_SECRET=replace-with-64-hex-chars
# Absolute session lifetime (hours) and idle timeout (minutes).
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=45
# Set true when TLS is terminated upstream (nginx). Required for Secure cookies.
COOKIE_SECURE=false
TRUST_PROXY=true

# ── Rate limiting (requests per window) ──────────────────────────────────────
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_API_PER_MIN=300

# ── Bootstrap ────────────────────────────────────────────────────────────────
# First user matching this email is promoted to ADMIN on first SSO login.
BOOTSTRAP_ADMIN_EMAIL=hari.setty@metricstream.com
# Seed demo data (dev only — never in production).
SEED_DEMO_DATA=true

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true
